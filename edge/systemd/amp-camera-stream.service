[Unit]
Description=AMP camera edge relay (IMX219-120 MJPEG streamer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/amp_edge
ExecStart=/usr/bin/python3 %h/amp_edge/camera_streamer.py --width 640 --height 480 --fps 15 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
