<?xml version="1.0"?>
<robot name="amp_robot">
  <link name="base_link"/>
  <link name="laser"/>
  <link name="camera"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.05 0 0.10" rpy="0 0 0"/>
  </joint>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera"/>
    <origin xyz="0.07 0 0.12" rpy="0 0 0"/>
  </joint>
</robot>
