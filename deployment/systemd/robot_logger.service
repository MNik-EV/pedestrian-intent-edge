[Unit]
Description=AMP Robot Logger
After=robot_core.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/amp-robot.env
WorkingDirectory=/opt/amp-robot/app
ExecStart=/opt/amp-robot/venv/bin/python -m amp_core.runtime_logger
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
